# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/freelanceflow

# JWT Secrets (use strong random strings in production)
JWT_ACCESS_SECRET=your_access_secret_key_here_make_it_long_and_random
JWT_REFRESH_SECRET=your_refresh_secret_key_here_make_it_long_and_random

# Email Configuration (for sending emails)
GMAIL_USER=your-email@gmail.com
GMAIL_PASS=your-app-password

# AI Integration (optional)
ANTHROPIC_API_KEY=your_anthropic_api_key
