# ================================================
# FreelanceFlow Enterprise Environment Variables
# ================================================

# ===================
# Server Config
# ===================
PORT=5000
NODE_ENV=development  # development | staging | production
LOG_LEVEL=info     # trace | debug | info | warn | error | fatal

# ===================
# MongoDB
# ===================
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/freelanceflow

# ===================
# JWT Secrets (CRITICAL)
# Generate strong random secrets:
# Run: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# ===================
JWT_ACCESS_SECRET=replace_this_with_a_secure_32_char_minimum_random_string
JWT_REFRESH_SECRET=replace_this_with_a_secure_32_char_minimum_random_string

# JWT Expiry (optional)
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ===================
# Security
# ===================
# Comma-separated list of allowed origins (production)
ALLOWED_ORIGINS=https://freelanceflow.vercel.app

# Session secret for cookies (optional, future)
SESSION_SECRET=replace_this_with_a_secure_random_string

# ===================
# Email (Gmail SMTP)
# ===================
GMAIL_USER=your-email@gmail.com
GMAIL_PASS=your-app-password

# ===================
# AI Integration (Optional)
# ===================
ANTHROPIC_API_KEY=sk-your-anthropic-api-key

# ===================
# Feature Flags
# ===================
ENABLE_RATE_LIMITING=true
ENABLE_AUDIT_LOGGING=true

# ===================
# Monitoring (Future)
# ===================
# SENTRY_DSN=your-sentry-dsn
# DATADOG_API_KEY=your-datadog-key