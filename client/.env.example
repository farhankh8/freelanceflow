# ================================================
# FreelanceFlow Client Environment Variables
# ================================================

# ===================
# API Configuration
# ===================
# The base URL for the backend API
# For local development (React dev server on port 5173): http://localhost:5000/api/v1
# For production: set to your deployed server URL (e.g., https://api.yourdomain.com/api/v1)
# Leave empty to use relative URLs (works for local dev with proxy)
VITE_API_URL=

# ===================
# AI Features (Optional)
# ===================
# Anthropic API key for AI chatbot features. Get from https://console.anthropic.com/
VITE_ANTHROPIC_API_KEY=

# ===================
# Analytics (Optional)
# ===================
# Google Analytics Measurement ID
# VITE_GA_ID=G-XXXXXXXXXX

# ===================
# Feature Flags
# ===================
# VITE_ENABLE_ANALYTICS=false
# VITE_ENABLE_DEBUG=false